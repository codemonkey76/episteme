# Bind address for the backend
BIND=127.0.0.1:3000

# Directory for SQLite database and uploads
DATA_DIR=data

# Directory for compiled frontend assets (backend/static after npm run build)
STATIC_DIR=static

# Log filter (see tracing-subscriber docs)
RUST_LOG=episteme=debug,tower_http=debug

# Public domain for the Caddy reverse proxy / Let's Encrypt cert.
# Required only when deploying with the caddy service in docker-compose.
# EPISTEME_DOMAIN=episteme.example.com

# Allow the session cookie over plain HTTP. The login cookie is marked Secure by
# default (HTTPS only). Set this when running the backend directly over http
# (e.g. local `cargo run` or the Vite dev server). Leave UNSET in production.
# AUTH_COOKIE_INSECURE=1

# Pre-seed an Anthropic API key (optional — can also be set in the UI)
# ANTHROPIC_API_KEY=sk-ant-...

# Pre-seed an OpenAI API key (optional)
# OPENAI_API_KEY=sk-...

# SearXNG endpoint for the agent's web_search tool. Defaults to the compose
# sidecar; override only if SearXNG runs elsewhere (e.g. local dev:
# http://localhost:8080 with the sidecar's port published).
# SEARXNG_URL=http://searxng:8080

# Firebase service-account JSON enabling mobile push notifications (FCM).
# Generate in Firebase console → Project settings → Service accounts, then
# drop the file at this path (default: {DATA_DIR}/firebase-service-account.json,
# i.e. on the episteme_data volume). Absent file = push disabled.
# FCM_SERVICE_ACCOUNT=/data/firebase-service-account.json
