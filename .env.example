# Bind address for the backend
BIND=127.0.0.1:3000

# Directory for SQLite database and uploads
DATA_DIR=data

# Directory for compiled frontend assets (backend/static after npm run build)
STATIC_DIR=static

# Log filter (see tracing-subscriber docs)
RUST_LOG=episteme=debug,tower_http=debug

# Pre-seed an Anthropic API key (optional — can also be set in the UI)
# ANTHROPIC_API_KEY=sk-ant-...

# Pre-seed an OpenAI API key (optional)
# OPENAI_API_KEY=sk-...
